# Copy to terraform.tfvars and edit before terraform init/plan/apply.
# Do not commit terraform.tfvars (contains secrets / account-specific values).

aws_region        = "il-central-1"
environment       = "production"

# New bucket for full-stack deploy. Do NOT use "ai-pdss" here — that bucket
# already exists and is managed outside this root module (see lambda-deploy/).
s3_bucket_name    = "document-search-prod-documents"

# ec2_ami_id = null  # omit or leave null for latest Amazon Linux 2 in region
ec2_instance_type = "t3.medium"
ec2_key_name      = "your-ec2-key-pair-name"  # create in EC2 → Key Pairs

openai_api_key    = "your-openai-api-key"
