dist/
build/
dist-ssr/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Test / coverage
coverage/
.nyc_output/
.jest/

# IDE (optional shared editor config may be committed via negation in subfolders)
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
